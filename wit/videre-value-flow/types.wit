package videre:value-flow@1.0.0;

/// Egress-neutral vocabulary for value in motion. Carries no dependency so it
/// outlives any contract built on it. EVM-only in 1.0.
///
/// Frozen at 1.0 under the strict policy in
/// docs/design/value-flow-versioning-policy.md: record fields may grow
/// additively within 1.x, variant cases are closed, and any variant growth
/// is 2.0.
interface types {
    /// 20-byte EVM address, big-endian.
    type address = list<u8>;

    /// Unsigned integer, big-endian, minimal-length: no leading zero bytes,
    /// zero is the empty list. Decoders MUST compare by integer value, not by
    /// byte equality.
    type uint = list<u8>;

    /// An ERC-20 token on the intent's settlement chain.
    record erc20 {
        token: address,
    }

    /// A venue-provided service, not a chain asset. Display-grade by
    /// construction: policy has teeth on enforceable legs only, and a
    /// service leg is never host-verified.
    record service-desc {
        /// Venue-scoped human-readable description of the service.
        description: string,
    }

    /// A kind of value that can move. The case set is closed at 1.0:
    /// erc721/erc1155/offchain are 2.0.
    variant asset {
        /// The settlement chain's gas token.
        native,
        erc20(erc20),
        /// A venue-provided service; the paired amount counts
        /// venue-defined units.
        service(service-desc),
    }

    /// An amount of one asset. Never negative; direction lives in the field
    /// that holds the pair (`gives` vs `wants`).
    record asset-amount {
        asset: asset,
        amount: uint,
    }
}
